---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import { site } from "../data/site";
import Header from "../components/Header.astro";
import SidebarNav from "../components/SidebarNav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  section?: string;
}

const {
  title = `${site.name} | ${site.subtitle}`,
  description = site.description,
  section = "Dashboard",
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="darkreader-lock" />
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />
    <meta name="theme-color" content="#061a2d" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@500;600;700&display=swap" rel="stylesheet" />
  <ClientRouter />
	</head>

  <body class="min-h-screen antialiased">
    <div class="min-h-screen bg-(--control-navy-deep)">
      <Header section={section} />

      <div class="flex min-h-[calc(100vh-4.5rem)]">
        <aside class="hidden w-64 shrink-0 border-r border-(--control-line) bg-(--control-navy) lg:block">
          <div class="sticky top-0 flex h-screen flex-col px-4 py-6">
            <div class="min-h-0 flex-1 overflow-y-auto pr-1">
              <SidebarNav currentPath={Astro.url.pathname} />
            </div>
          </div>
        </aside>

        <main class="min-w-0 flex-1">
          <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
            <slot />
            <Footer />
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
