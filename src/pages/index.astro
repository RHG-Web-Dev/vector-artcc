---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CraftReference from "../components/CraftReference.astro";
import AirspaceReference from "../components/AirspaceReference.astro";
import { dashboardCards } from "../data/navigation";
import { controllerModePreview, quickReference } from "../data/control";
import { site } from "../data/site";
---

<Layout
  title=`${site.name} | ARTCC Controller Companion`
  description=`${site.name} is a professional reference, training, and utility platform for VATSIM air traffic controllers.`
  section="Dashboard"
>
  <div class="space-y-10">
    <section class="border-b border-[var(--control-line)] pb-8">
      <div class="max-w-4xl">
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-[var(--control-blue-bright)]">ARTCC Controller Companion</p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-white sm:text-5xl">{site.name}</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--control-muted)]">
          A focused reference and training workspace for VATSIM controllers. Find procedures, learn concepts, and keep essential information close while working traffic.
        </p>
      </div>
    </section>

    <section class="grid gap-px border border-[var(--control-line)] bg-[var(--control-line)] md:grid-cols-2 xl:grid-cols-3">
      {dashboardCards.map((card) => (
        <a href={card.href} class="group bg-[var(--control-navy)] p-5 transition-colors hover:bg-[var(--control-panel)]">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-[var(--control-blue-bright)]">{card.label}</p>
          <h2 class="mt-2 font-display text-xl font-semibold text-white">{card.title}</h2>
          <p class="mt-2 text-sm leading-6 text-[var(--control-muted)]">{card.description}</p>
          <p class="mt-4 text-xs font-semibold uppercase tracking-[0.16em] text-slate-400 group-hover:text-white">Open →</p>
        </a>
      ))}
    </section>

