---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import SectionHeader from "../components/SectionHeader.astro";
import {
  getSections,
  getSectionPages,
} from "../data/navigation";
import { site } from "../data/site";

const sections = await getSections();

const sectionData = await Promise.all(
  sections.map(async (section) => {
    const pages = await getSectionPages(section.key);

    return {
      ...section,
      pages,
    };
  }),
);

const recentlyUpdated = sectionData
  .flatMap((section) =>
    section.pages.map((page) => ({
      ...page,
      sectionTitle: section.title,
    })),
  )
  .filter((page) => page.updated)
  .sort((a, b) => {
    const dateA = new Date(a.updated!).getTime();
    const dateB = new Date(b.updated!).getTime();

    return dateB - dateA;
  })
	.filter((page) => {
		const dateUpdated = new Date(page.updated!).getTime();
		const thirtyDaysAgo = new Date().getTime() - 30 * 24 * 60 * 60 * 1000;

		return dateUpdated >= thirtyDaysAgo;
	})
  .slice(0, 8);
---

<Layout
  title={`${site.name} ─ ARTCC Controller Companion`}
  description="A practical reference, training, and toolkit platform for controllers."
>
  <section class="space-y-8">

    <!-- Hero -->

		<header class="grid items-center gap-6 border-b border-(--control-line) pb-7 text-center sm:grid-cols-2 sm:gap-8 sm:text-left">
			<Image
				height="1080"
				width="1920"
				src="/img/favicon.svg"
				alt="VECTOR"
				class="mx-auto w-full max-w-md sm:mx-0"
			/>
			<div class="text-center sm:text-left">
				<h1
					class="font-semibold uppercase tracking-[0.28em] text-(--control-blue-bright)"
				>
					ARTCC CONTROLLER COMPANION
				</h1>
				<p class="mt-3 max-w-2xl text-base leading-7 text-slate-300">
					A practical reference, training, and toolkit platform for controllers.
				</p>
			</div>
		</header>


    <!-- Sections -->

    <section>
      <SectionHeader
        chips={[
					{
						text: 'Reference',
					}
				]}
        title="Controller resources"
        description="Quick access to the information you need while controlling."
      />

      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {sectionData.map((section) => (
          <Card
						href={`/${section.key}`}
						interactive
						class="group relative overflow-hidden"
					>
						<div class="relative z-10 max-w-[75%] space-y-2">

							<h2 class="font-display text-lg font-semibold text-white">
								{section.title}
							</h2>

							{section.description && (
								<p class="text-sm leading-6 text-slate-400">
									{section.description}
								</p>
							)}

							<p class="font-mono text-xs text-slate-500">
								{section.pages.length}{" "}
								reference{section.pages.length === 1 ? "" : "s"}
							</p>

						</div>

						{section.icon && (
							<Icon
								name={section.icon}
								class="pointer-events-none absolute -bottom-10 -right-4 z-0 text-[10rem] rotate-12 text-(--control-blue-bright)/10 transition-all duration-300 group-hover:rotate-7 group-hover:scale-110 group-hover:text-(--control-blue-bright)/15"
							/>
						)}
					</Card>	
        ))}
      </div>
    </section>


    <!-- Recently Updated -->

    <section>
      <SectionHeader
         chips={[
					{
						text: 'Updates',
					}
				]}
        title="Recently updated"
        description="The latest changes and additions to the reference library."
      />

      <div
        class="mt-5 divide-y divide-(--control-line) border-y border-(--control-line)"
      >
        {recentlyUpdated.length > 0 ? (
          recentlyUpdated.map((page) => (
            <a
              href={page.href}
              class="flex flex-col gap-2 px-4 py-4 transition hover:bg-(--control-panel) sm:flex-row sm:items-center sm:justify-between"
            >
              <div class="min-w-0">

                <p class="text-sm font-medium text-white">
                  {page.label}
                </p>

                {page.description && (
                  <p class="mt-1 text-sm text-slate-400">
                    {page.description}
                  </p>
                )}

              </div>

              <div class="flex shrink-0 items-center gap-4">

                <span
                  class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-(--control-muted)"
                >
                  {page.sectionTitle}
                </span>

                {page.updated && (
                  <time
                    datetime={page.updated}
                    class="font-mono text-xs text-slate-500"
                  >
                    {new Date(page.updated).toLocaleDateString(
                      "en-US",
                      {
                        month: "short",
                        day: "numeric",
                        year: "numeric",
                      },
                    )}
                  </time>
                )}

              </div>
            </a>
          ))
        ) : (
          <div class="px-4 py-8">
            <p class="text-sm text-slate-500">
              No recently updated material is available.
            </p>
          </div>
        )}
      </div>
    </section>


    <!-- Empty state if no sections exist -->

    {sectionData.length === 0 && (
      <section>
        <div class="border border-(--control-line) bg-(--control-panel) p-6">
          <p class="text-sm text-slate-400">
            No reference sections have been published yet.
          </p>
        </div>
      </section>
    )}

  </section>
</Layout>
