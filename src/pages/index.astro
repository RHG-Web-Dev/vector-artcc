---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { getCollection } from "astro:content";

const sections = [
  {
    key: "learn",
    title: "Learn",
    description: "Core aviation and controller knowledge.",
  },
  {
    key: "reference",
    title: "Reference",
    description: "Fast-reference material for controlling.",
  },
  {
    key: "kmem",
    title: "KMEM",
    description: "Facility-specific information and procedures.",
  },
  {
    key: "training",
    title: "Training",
    description: "Training material, sessions, and scenarios.",
  },
  {
    key: "resources",
    title: "Resources",
    description: "External references and supporting material.",
  },
] as const;

const sectionData = await Promise.all(
  sections.map(async (section) => {
    const entries = await getCollection(section.key);

    return {
      ...section,
      entries: entries
        .sort((a, b) => a.data.title.localeCompare(b.data.title))
        .slice(0, 3),
    };
  }),
);
---

<Layout
  title="CONTROL | ARTCC Controller Companion"
  description="A practical reference, training, and toolkit platform for VATSIM controllers."
>
  <section class="space-y-8">
    <header class="border-b border-[var(--control-line)] pb-7">
      <p class="text-[0.68rem] font-semibold uppercase tracking-[0.28em] text-[var(--control-blue-bright)]">
        ARTCC CONTROLLER COMPANION
      </p>

      <h1 class="mt-3 font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">
        CONTROL
      </h1>

      <p class="mt-3 max-w-2xl text-base leading-7 text-slate-300">
        A practical reference, training, and toolkit platform for controllers.
      </p>
    </header>

    <section>
      <SectionHeader
        eyebrow="Reference"
        title="Controller resources"
        description="Quick access to the information you need while controlling."
      />

      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {sectionData.map((section) => (
          <Card href={`/${section.key}`} interactive>
            <div class="space-y-2">
              <h2 class="font-display text-lg font-semibold text-white">
                {section.title}
              </h2>

              <p class="text-sm leading-6 text-slate-400">
                {section.description}
              </p>

              <p class="font-mono text-xs text-slate-500">
                {section.entries.length} reference{section.entries.length === 1 ? "" : "s"}
              </p>
            </div>
          </Card>
        ))}
      </div>
    </section>

    <section>
      <SectionHeader
        eyebrow="Latest"
        title="Reference material"
        description="Recently available material across CONTROL."
      />

      <div class="mt-5 divide-y divide-[var(--control-line)] border-y border-[var(--control-line)]">
        {
          sectionData
            .flatMap((section) =>
              section.entries.map((entry) => ({
                ...entry,
                section: section.title,
                sectionKey: section.key,
              })),
            )
            .slice(0, 8)
            .map((entry) => (
              <a
                href={`/${entry.sectionKey}/${entry.id}`}
                class="flex flex-col gap-1 px-4 py-4 transition hover:bg-[var(--control-panel)] sm:flex-row sm:items-center sm:justify-between"
              >
                <div>
                  <p class="text-sm font-medium text-white">
                    {entry.data.title}
                  </p>

                  <p class="mt-1 text-sm text-slate-400">
                    {entry.data.description}
                  </p>
                </div>

                <span class="font-mono text-[0.68rem] uppercase tracking-[0.16em] text-[var(--control-muted)]">
                  {entry.section}
                </span>
              </a>
            ))
        }
      </div>
    </section>
  </section>
</Layout>