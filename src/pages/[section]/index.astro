---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { Icon } from "astro-icon/components";
import {
  getSections,
  getSectionPages,
} from "../../data/navigation";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const sections = await getSections();

  return sections.map((section) => ({
    params: {
      section: section.key,
    },
  }));
}

const sectionKey = Astro.params.section;

const sections = await getSections();

const section = sections.find(
  (item) => item.key === sectionKey,
);

if (!section) {
  throw new Error(
    `Unknown section: ${sectionKey}`,
  );
}

const pages = await getSectionPages(
  section.key,
);
---

<Layout
  title={`${site.name} ─ ${section.title}`}
  description={section.description}
  section={section.title}
>
  <section class="space-y-8">

    <!-- Section Header -->
    <SectionHeader
      title={section.title}
      description={section.description}
    />

    {pages.length > 0 ? (
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">

        {pages.map((page) => (
          <Card
            href={page.href}
            interactive
            class={`group relative overflow-hidden ${
              page.featured
                ? "border-yellow-400/30 hover:border-yellow-400/60"
                : ""
            }`}
          >

            <!-- Featured indicator -->
            {page.featured && (
              <div
                class="absolute right-4 top-4 z-20"
                title="Featured reference"
                aria-label="Featured reference"
              >
                <Icon
                  name="mdi:star"
                  class="text-lg text-yellow-400 transition-transform duration-300 group-hover:scale-110 group-hover:rotate-12"
                />
              </div>
            )}

            <!-- Card content -->
            <div class="relative z-10 flex min-h-48 flex-col">

              <div class="flex-1 space-y-3">

                {page.category && (
                  <div class="flex items-center gap-2">
                    <span class="h-px w-5 bg-(--control-blue-bright)/60"></span>

                    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.24em] text-(--control-blue-bright)">
                      {page.category}
                    </p>
                  </div>
                )}

                <h2 class="font-display text-xl font-semibold leading-tight text-white transition-colors group-hover:text-(--control-blue-bright)">
                  {page.label}
                </h2>

                {page.description && (
                  <p class="text-sm leading-6 text-slate-400">
                    {page.description}
                  </p>
                )}

              </div>

              <!-- Bottom action -->
              <div class="mt-6 flex items-center justify-between border-t border-(--control-line) pt-4">

                <span class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-slate-600">
                  Reference
                </span>

                <span class="text-sm font-medium text-sky-200 transition-transform duration-200 group-hover:translate-x-1">
                  Open →
                </span>

              </div>

            </div>

            <!-- Decorative background icon -->
						{/* {
							page.icon && (
								<Icon
									name={page.icon}
									class="pointer-events-none absolute -bottom-12 -right-10 z-0 text-[9rem] rotate-12 text-(--control-blue-bright)/[0.035] transition-all duration-500 group-hover:rotate-[-7deg] group-hover:scale-110 group-hover:text-(--control-blue-bright)/[0.07]"
								/>
							)
						} */}

          </Card>
        ))}

      </div>
    ) : (

      <Card>
        <div class="flex items-start gap-4">

          <div class="flex h-10 w-10 shrink-0 items-center justify-center border border-(--control-line-strong) bg-(--control-navy-deep)">
            <Icon
              name="mdi:information-outline"
              class="text-xl text-slate-500"
            />
          </div>

          <div>
            <h2 class="font-display text-base font-semibold text-white">
              No references available
            </h2>

            <p class="mt-1 text-sm leading-6 text-slate-400">
              No reference material has been published
              in this section yet.
            </p>
          </div>

        </div>
      </Card>

    )}

  </section>
</Layout>