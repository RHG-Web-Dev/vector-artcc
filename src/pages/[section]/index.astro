---
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import {
  getSections,
  getSectionPages,
} from "../../data/navigation";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const sections = await getSections();

  return sections.map((section) => ({
    params: {
      section: section.key,
    },
  }));
}

const sectionKey = Astro.params.section;

const sections = await getSections();

const section = sections.find(
  (item) => item.key === sectionKey,
);

if (!section) {
  throw new Error(
    `Unknown section: ${sectionKey}`,
  );
}

const pages = await getSectionPages(
  section.key,
);
---

<Layout
  title={`${site.name} | ${section.title}`}
  description={section.description}
  section={section.title}
>
  <section class="space-y-8">

    <SectionHeader
      title={section.title}
      description={section.description}
    />

    {pages.length > 0 ? (
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">

        {pages.map((page) => (
          <Card
            href={page.href}
            interactive
          >
            <div class="relative space-y-3">

              {page.featured && (
                <div
                  class="absolute right-0 top-0"
                  title="Featured reference"
                  aria-label="Featured reference"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    class="h-4 w-4 text-yellow-400"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433L10.788 3.21z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </div>
              )}

              {page.category && (
                <p class="text-[0.68rem] uppercase tracking-[0.24em] text-slate-500">
                  {page.category}
                </p>
              )}

              <h2 class="font-display text-xl font-semibold text-white">
                {page.label}
              </h2>

              {page.description && (
                <p class="text-sm leading-6 text-slate-300">
                  {page.description}
                </p>
              )}

              <p class="text-sm text-sky-200">
                Open reference →
              </p>

            </div>
          </Card>
        ))}

      </div>
    ) : (
      <div class="border border-[var(--control-line)] bg-[var(--control-panel)] p-6">
        <p class="text-sm text-slate-400">
          No reference material has been published
          in this section yet.
        </p>
      </div>
    )}

  </section>
</Layout>