---
import Layout from "../../layouts/Layout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getCollection, render } from "astro:content";
export async function getStaticPaths() {
  const entries = await getCollection("content");

  const paths = [];

  for (const entry of entries) {
    const parts = entry.id.split("/");

    if (parts.length !== 2) continue;
    
    const section = parts[0];
    const filename = parts[1];

    if (filename.startsWith("_")) continue;
    if (entry.data.hidden) continue

    const slug = filename.replace(/\.(md|mdx)$/,"",);

    paths.push({
      params: { section, slug },
      props: { entry },
    });
  }

  return paths;
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const section = Astro.params.section ?? "";
const title = entry.data.title;
const description = entry.data.description ?? "";
const dateUpdated = entry.data.updated ? new Date(entry.data.updated) : null;
const dateUpdatedString = dateUpdated ? dateUpdated.toLocaleDateString("en-US", {
	weekday: "long",
	year: "numeric",
	month: "long",
	day: "numeric",
}) : null;
const daysAgo = dateUpdated ? Math.floor((new Date().getTime() - dateUpdated.getTime()) / (1000 * 60 * 60 * 24)) : null;

---

<Layout
  title={title}
  description={description}
  section={section}
>
  <article class="space-y-8">

    <SectionHeader
			chips={[
				{
					text: section,
					link: `/${section}`,
				},
				...(daysAgo !== null
					? [
							{
								text: `Updated: ${dateUpdatedString}, ${daysAgo} day${daysAgo === 1 ? '' : 's'} ago`,
                tone: 'blue' as const,
							},
						]
					: []),
			]}
			title={title}
			description={description}
		/>	
    <div class="
		prose prose-invert max-w-none
		white-space: pre-line
    [&_table]:border-collapse
    [&_table]:text-sm
		[&_table]:text-slate-300
    [&_th]:bg-slate-800
    [&_th]:px-4
    [&_th]:py-3
    [&_th]:text-center
    [&_th]:text-(--control-blue-bright)
    [&_td]:border
    [&_td]:border-(--control-line)
    [&_td]:px-3
    [&_td]:py-3
    [&_td]:align-top
    [&_td]:text-slate-300
    [&_tr]:transition-colors
    [&_tbody_tr:hover]:bg-slate-800/80
  ">
      <Content />
    </div>
  </article>
</Layout>