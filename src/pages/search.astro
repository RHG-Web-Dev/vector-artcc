---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Search from "../components/Search.astro";
import { site } from "../data/site";
---

<Layout title={`${site.name} ─ Search`} description={`Search ${site.name} training, references, resources, and tools.`} section="Search">
  <article class="space-y-8">
    <SectionHeader
      title="Search"
      description="Find training, references, resources, and tools across Vector ARTCC."
    />
    <Search page />
  </article>
</Layout>
