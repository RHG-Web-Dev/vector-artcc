---
import Layout from "../layouts/Layout.astro";
import Badge from "../components/Badge.astro";
import Card from "../components/Card.astro";
import SectionHeader from "../components/SectionHeader.astro";

const tools = [
	{ title: 'CRAFT Builder', description: 'Compose clearance flows for future controller mode support.' },
	{ title: 'Altitude Checker', description: 'Support for direction-of-flight and altitude selection logic.' },
	{ title: 'Equipment Suffix Lookup', description: 'Lookup utility for aircraft equipment suffix reminders.' },
	{ title: 'Route / SID Helper', description: 'Quick helper for route and procedure planning.' },
];
---

<Layout
  title="CONTROL | Tools"
  description="Utility surfaces for future CRAFT, altitude, and lookup tools."
  section="Tools"
>
  <section class="space-y-6">
    <Card>
      <div class="space-y-3">
        <Badge tone="blue">Tools</Badge>
        <h1 class="font-display text-4xl font-semibold text-white">Utility surfaces, not a dashboard gimmick.</h1>
        <p class="max-w-3xl text-base leading-7 text-slate-300">The tools area is reserved for small, task-focused utilities that help while controlling. Keep the initial versions narrow, quick, and reliable.</p>
      </div>
    </Card>

    <SectionHeader
      eyebrow="Planned"
      title="Foundational tool slots"
      description="These are the surfaces that can grow into client-side utilities later without changing the main shell."
    />

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-2">
      {tools.map((tool) => (
        <Card>
          <div class="space-y-3">
            <Badge tone="slate">Future</Badge>
            <h2 class="font-display text-xl font-semibold text-white">{tool.title}</h2>
            <p class="text-sm leading-6 text-slate-300">{tool.description}</p>
          </div>
        </Card>
      ))}
    </div>
  </section>
</Layout>