---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import SectionHeader from "../components/SectionHeader.astro";
import CraftReference from "../components/CraftReference.astro";
import AirspaceReference from "../components/AirspaceReference.astro";
import { dashboardCards } from "../data/navigation";
import { controllerModePreview, quickReference } from "../data/control";
import { site } from "../data/site";
---

<Layout
  title=`${site.name} | ARTCC Controller Companion`
  description=`${site.name} is a professional reference, training, and utility platform for VATSIM air traffic controllers.`
  section="Dashboard"
>
  <div class="space-y-10">
    <h>404 - Page Not Found</h>
		<p class="max-w-2xl text-base leading-7 text-[var(--control-muted)]">
			The page you are looking for does not exist.
		</p>
		<a href="/" class="inline-block rounded bg-[var(--control-blue-bright)] px-4 py-2 text-sm font-semibold text-white hover:bg-[var(--control-blue)]">Return to Dashboard</a>
  </div>
</Layout>
