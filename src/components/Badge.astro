---
interface Props {
  label?: string;
  tone?: 'blue' | 'slate' | 'green' | 'amber';
  class?: string;
}

const { label, tone = 'slate', class: className = '' } = Astro.props;

const toneClasses = {
  blue: 'border-[#2a638c] bg-[#0d2941] text-[#b9def3]',
  slate: 'border-[#1b405d] bg-[#0a2135] text-[#c4d2dd]',
  green: 'border-[#2d6b57] bg-[#10382f] text-[#b8e3d3]',
  amber: 'border-[#735f32] bg-[#3b3018] text-[#ead8a6]',
}[tone];
---

<span class={`inline-flex items-center border px-2 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.2em] ${toneClasses} ${className}`}>
  <slot>{label}</slot>
</span>
