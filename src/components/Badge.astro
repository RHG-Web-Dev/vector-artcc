---
interface Props {
	label?: string;
	tone?: 'blue' | 'slate' | 'green' | 'amber';
	class?: string;
}

const { label, tone = 'slate', class: className = '' } = Astro.props;

const toneClasses = {
	blue: 'border-sky-400/25 bg-sky-400/10 text-sky-100',
	slate: 'border-white/10 bg-white/5 text-slate-200',
	green: 'border-emerald-400/25 bg-emerald-400/10 text-emerald-100',
	amber: 'border-amber-400/25 bg-amber-400/10 text-amber-100',
}[tone];
---

<span class={`inline-flex items-center rounded-full border px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.28em] ${toneClasses} ${className}`}>
	
	<slot>{label}</slot>
</span>