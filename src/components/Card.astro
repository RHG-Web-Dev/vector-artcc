---
interface Props {
	href?: string;
	class?: string;
	interactive?: boolean;
}

const { href, class: className = '', interactive = false } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag
	href={href}
	class={`group block rounded-xl surface p-4 transition ${interactive || href ? 'hover:border-sky-400/30 hover:bg-white/[0.04]' : ''} ${className}`}
>
	<slot />
</Tag>