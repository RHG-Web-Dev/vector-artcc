---
interface Props {
  href?: string;
  class?: string;
  interactive?: boolean;
}

const { href, class: className = '', interactive = false } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag
  href={href}
  class={`group block surface p-5 ${interactive || href ? 'transition hover:border-[#2a638c] hover:bg-[var(--control-panel-alt)]' : ''} ${className}`}
>
  <slot />
</Tag>
