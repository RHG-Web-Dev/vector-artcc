---
import { Icon } from "astro-icon/components";
import SidebarNav from "./SidebarNav.astro";
import Search from "./Search.astro";
import { site } from "../data/site";

interface Props {
  section?: string;
}
---

<header class="border-b border-(--control-line) bg-(--control-navy)">
  <div class="flex min-h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex min-w-0 items-center gap-3" aria-label={`${site.name} home`}>
      <img src="/img/favicon.svg" alt={`${site.name} mark`} class="h-16 w-16" />
      <div class="min-w-0 leading-none">
        <span class="hidden md:block font-display text-xl font-bold tracking-wide text-white">ARTCC CONTROLLER COMPANION</span>
        <span class="hidden lg:block mt-1 text-[0.62rem] font-medium uppercase tracking-[0.22em] text-(--control-muted)">A practical reference, training, and toolkit platform for controllers.</span>
      </div>
    </a>

    <div class="flex items-center gap-2">
      <Search />
      <a href="/search" class="inline-flex items-center border border-(--control-line-strong) bg-(--control-navy-deep) px-3 py-3 text-white hover:bg-(--control-panel-strong) lg:hidden" aria-label="Search">
				<Icon name="mdi:search" class="h-4 w-4" />
			</a>
      <button id="mobile-menu-button" class="inline-flex items-center border border-(--control-line-strong) bg-(--control-navy-deep) px-3 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white hover:bg-(--control-panel-strong) lg:hidden" aria-controls="mobile-menu" aria-expanded="false" type="button">Menu</button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-(--control-line) bg-(--control-navy-deep) px-4 py-4 sm:px-6 lg:hidden">
    <SidebarNav currentPath={Astro.url.pathname} mobile />
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isHidden));
  });
</script>
