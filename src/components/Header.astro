---
import { site } from "../data/site";
import SidebarNav from "./SidebarNav.astro";

interface Props {
  section?: string;
}

const { section = "Dashboard" } = Astro.props;
---

<header class="border-b border-[#1b405d] bg-[#061a2d]">
  <div class="mx-auto max-w-[1440px]">
    <div class="flex min-h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <a href="/" class="flex min-w-0 items-center gap-4">
        <div class="hidden h-9 w-1 bg-[#2d9de0] sm:block"></div>
        <div class="min-w-0">
          <p class="text-[0.65rem] font-semibold uppercase tracking-[0.32em] text-[#6eb9e6]">Memphis ARTCC</p>
          <div class="mt-0.5 flex items-baseline gap-3">
            <span class="font-display text-xl font-bold tracking-wide text-white">CONTROL</span>
            <span class="hidden truncate text-xs uppercase tracking-[0.18em] text-[#9bb0c1] sm:inline">Controller Companion</span>
          </div>
        </div>
      </a>

      <div class="flex items-center gap-4">
        <div class="hidden text-right md:block">
          <p class="text-[0.62rem] uppercase tracking-[0.25em] text-[#718ba0]">Current Section</p>
          <p class="mt-0.5 text-sm font-medium text-white">{section}</p>
        </div>
        <button
          id="mobile-menu-button"
          class="inline-flex items-center border border-[#2a638c] bg-[#0a2135] px-3 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white hover:bg-[#0d2941] lg:hidden"
          aria-controls="mobile-menu"
          aria-expanded="false"
          type="button"
        >
          Menu
        </button>
      </div>
    </div>

    <div class="hidden border-t border-[#123650] lg:flex lg:items-center lg:justify-between px-4 sm:px-6 lg:px-8">
      <nav aria-label="Site utility navigation" class="flex items-center gap-6 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-[#9bb0c1]">
        <a href="/" class="hover:text-white">Home</a>
        <a href="/learn" class="hover:text-white">Learn</a>
        <a href="/reference" class="hover:text-white">Reference</a>
        <a href="/kmem" class="hover:text-white">KMEM</a>
        <a href="/training" class="hover:text-white">Training</a>
        <a href="/tools" class="hover:text-white">Tools</a>
      </nav>
      <span class="py-2 text-[0.62rem] uppercase tracking-[0.18em] text-[#718ba0]">ZME / KMEM</span>
    </div>

    <div id="mobile-menu" class="hidden border-t border-[#1b405d] bg-[#041321] px-4 py-4 sm:px-6 lg:hidden">
      <SidebarNav currentPath={Astro.url.pathname} mobile />
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isHidden));
  });
</script>