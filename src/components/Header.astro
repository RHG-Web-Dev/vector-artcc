---
import { site } from "../data/site";
import SidebarNav from "./SidebarNav.astro";

interface Props {
  section?: string;
}

const { section = "Dashboard" } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-white/8 bg-slate-950/90 backdrop-blur-xl">
  <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8 xl:px-8">
    <div class="min-w-0">
      <p class="text-[0.65rem] uppercase tracking-[0.38em] text-sky-300/90">CONTROL</p>
      <div class="mt-1 flex items-center gap-3">
        <h2 class="truncate font-display text-lg font-semibold text-white sm:text-xl">{section}</h2>
        <span class="hidden rounded-full border border-sky-400/20 bg-sky-400/10 px-2.5 py-1 text-[0.65rem] uppercase tracking-[0.28em] text-sky-100 md:inline-flex">
          {site.brandSubline}
        </span>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <label class="hidden items-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-3 py-2 text-xs text-slate-300 lg:flex" for="site-search">
        <span class="uppercase tracking-[0.24em] text-slate-500">Search</span>
        <input id="site-search" type="search" placeholder="CTRL+K later" class="w-36 bg-transparent text-slate-100 placeholder:text-slate-500 focus:outline-none" />
      </label>
      <button
        id="mobile-menu-button"
        class="inline-flex items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-2 text-sm font-medium text-slate-100 transition hover:border-sky-400/30 hover:bg-white/[0.06] xl:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        type="button"
      >
        <span class="text-sm uppercase tracking-[0.28em] text-slate-400">Menu</span>
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/8 bg-slate-950/95 px-4 py-4 xl:hidden">
    <SidebarNav currentPath={Astro.url.pathname} mobile />
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  btn?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isHidden));
  });
</script>