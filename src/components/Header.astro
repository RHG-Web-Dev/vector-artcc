---
import SidebarNav from "./SidebarNav.astro";
import { site } from "../data/site";

interface Props {
  section?: string;
}

const { section = "Dashboard" } = Astro.props;
---

<header class="border-b border-[var(--control-line)] bg-[var(--control-navy)]">
  <div class="flex min-h-16 items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex min-w-0 items-center gap-4">
      <div class="hidden h-9 w-1 bg-[var(--control-blue-bright)] sm:block"></div>
      <div class="min-w-0">
        <div class="mt-0.5 flex items-baseline gap-3">
					<img src="/img/favicon.svg" alt=`{site.name} mark` class="h-6 w-6 shrink-0" />
          <span class="font-display text-xl font-bold tracking-wide text-white">{site.name}</span>
          <span class="hidden truncate text-xs uppercase tracking-[0.18em] text-[var(--control-muted)] sm:inline">Controller Companion</span>
        </div>
      </div>
    </a>

    <div class="flex items-center gap-5">
      <div class="hidden items-center gap-2 border-r border-[var(--control-line)] pr-5 sm:flex" aria-live="polite">
        <span class="h-2 w-2 rounded-full bg-emerald-400" aria-hidden="true"></span>
        <div class="text-right leading-tight">
          <p class="text-[0.58rem] uppercase tracking-[0.2em] text-[var(--control-muted)]">Online Controllers</p>
          <p id="online-controller-count" class="font-mono text-sm font-semibold text-white">—</p>
        </div>
      </div>

      <div class="hidden text-right md:block">
        <p class="text-[0.62rem] uppercase tracking-[0.25em] text-[var(--control-muted)]">Current Section</p>
        <p class="mt-0.5 text-sm font-medium text-white">{section}</p>
      </div>

      <button
        id="mobile-menu-button"
        class="inline-flex items-center border border-[var(--control-line-strong)] bg-[var(--control-navy-deep)] px-3 py-2 text-xs font-semibold uppercase tracking-[0.2em] text-white hover:bg-[var(--control-panel-strong)] lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        type="button"
      >
        Menu
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-[var(--control-line)] bg-[var(--control-navy-deep)] px-4 py-4 sm:px-6 lg:hidden">
    <SidebarNav currentPath={Astro.url.pathname} mobile />
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");
  const controllerCount = document.getElementById("online-controller-count");
  const controllerApi = "https://api.vatsim.net/v2/atc/online";
  const refreshInterval = 60_000;

  btn?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    btn.setAttribute("aria-expanded", String(!isHidden));
  });

  async function updateOnlineControllers() {
    if (!controllerCount) return;

    try {
      const response = await fetch(controllerApi, {
        headers: { Accept: "application/json" },
      });

      if (!response.ok) throw new Error(`VATSIM API returned ${response.status}`);

      const data = await response.json();
      const controllers = Array.isArray(data) ? data : data.data;
      controllerCount.textContent = Array.isArray(controllers)
        ? controllers.length.toLocaleString()
        : "—";
    } catch {
      controllerCount.textContent = "—";
    }
  }

  updateOnlineControllers();
  setInterval(updateOnlineControllers, refreshInterval);
</script>
