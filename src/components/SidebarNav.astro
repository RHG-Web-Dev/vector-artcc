---
import { navSections } from '../data/navigation';

interface Props {
  currentPath: string;
  mobile?: boolean;
}

const { currentPath, mobile = false } = Astro.props;
const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
---

<nav aria-label="Primary navigation" class="space-y-5">
  {navSections.map((section) => (
    <section class="space-y-1.5">
      <p class="px-2 text-[0.62rem] font-semibold uppercase tracking-[0.22em] text-[var(--control-muted)]">{section.label}</p>
      <div>
        {section.items.map((item) => (
          <a
            href={item.href}
            class={`flex items-center border-l-2 px-3 py-1.5 text-sm leading-5 transition-colors ${isActive(item.href) ? 'border-[var(--control-blue-bright)] bg-[var(--control-panel-alt)] font-semibold text-white' : 'border-transparent text-[var(--control-muted)] hover:border-[var(--control-line-strong)] hover:bg-[var(--control-panel)] hover:text-white'}`}
          >
            <span>{item.label}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</nav>
