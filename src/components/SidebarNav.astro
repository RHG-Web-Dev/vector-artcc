---
import { Icon } from "astro-icon/components";
import {
  getSections,
  getSectionPages,
} from "../data/navigation";

interface Props {
  currentPath: string;
  mobile?: boolean;
}

const {
  currentPath,
  mobile = false,
} = Astro.props;

const sections = await getSections();

const navigationSections = await Promise.all(
  sections.map(async (section) => ({
    ...section,
    pages: await getSectionPages(section.key),
  })),
);
---

<nav
  aria-label="Primary navigation"
  class:list={[
    mobile ? "space-y-2" : "space-y-2",
  ]}
>
  <!-- Dashboard -->
  <a
    href="/"
    class:list={[
      "inline-flex items-center gap-2 border-l-2 px-3 py-1.5 text-sm font-semibold uppercase tracking-[0.14em] transition",
      currentPath === "/"
        ? "border-(--control-blue-bright) bg-(--control-panel) text-white"
        : "border-transparent text-slate-300 hover:border-(--control-blue) hover:text-white",
    ]}
  >
			<Icon name='mdi:home' class="h-4 w-4" />
    Dashboard
  </a>

	<!-- Search -->
  <a
    href="/search"
    class:list={[
      "inline-flex items-center gap-2 border-l-2 px-3 py-1.5 text-sm font-semibold uppercase tracking-[0.14em] transition",
      currentPath === "/search"
        ? "border-(--control-blue-bright) bg-(--control-panel) text-white"
        : "border-transparent text-slate-300 hover:border-(--control-blue) hover:text-white",
    ]}
  >
		<Icon name='mdi:search' class="h-4 w-4" />
    Search
  </a>

  <!-- Sections -->
  <div class="space-y-5">
    {navigationSections.map((section) => {
      const sectionHref = `/${section.key}`;

      const sectionActive =
        currentPath === sectionHref ||
        currentPath.startsWith(`/${sectionHref}/`);

      return (
        <section>
          <!-- Section -->
          <a
            href={sectionHref}
            class:list={[
              "inline-flex items-center gap-2 border-l-2 px-3 py-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.25em] transition",
              sectionActive
                ? "border-(--control-blue-bright) text-white"
                : "border-transparent text-(--control-muted) hover:border-(--control-blue) hover:text-white",
            ]}
          >
						{ section.icon && <Icon name={section.icon} class="h-4 w-4" /> }
            {section.title}
          </a>

          <!-- Pages -->
          {section.pages.length > 0 && (
            <ul class="mt-1">
              {section.pages.map((page) => {
                const active =
                  currentPath === page.href;

                return (
                  <li>
                    <a
                      href={page.href}
                      class:list={[
                        "flex items-center justify-between border-l-2 px-3 py-1.5 pl-5 text-sm transition",
                        active
                          ? "border-(--control-blue-bright) bg-(--control-panel) font-medium text-white"
                          : "border-transparent text-slate-400 hover:border-(--control-blue) hover:text-white",
                      ]}
                    >	
                      <span>{page.label}</span>

                      {page.featured && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          class="ml-2 h-3.5 w-3.5 shrink-0 text-yellow-400 opacity-40"
                          aria-label="Featured"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433L10.788 3.21z"
                            clip-rule="evenodd"
                          />
                        </svg>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      );
    })}
  </div>
</nav>