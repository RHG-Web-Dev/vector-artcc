---
import {
  getSections,
  getSectionPages,
} from "../data/navigation";

interface Props {
  currentPath: string;
  mobile?: boolean;
}

const { currentPath, mobile = false } = Astro.props;

const sections = await getSections();

const navigationSections = await Promise.all(
  sections.map(async (section) => ({
    ...section,
    pages: await getSectionPages(section.key),
  })),
);
---

<nav
  aria-label="Primary navigation"
  class:list={[
    mobile ? "" : "space-y-6",
  ]}
>
  <!-- Dashboard -->
  <a
    href="/"
    class:list={[
      "block border-l-2 px-3 py-2 text-sm font-semibold uppercase tracking-[0.14em] transition",
      currentPath === "/"
        ? "border-[var(--control-blue-bright)] bg-[var(--control-panel)] text-white"
        : "border-transparent text-slate-300 hover:border-[var(--control-blue)] hover:text-white",
    ]}
  >
    Dashboard
  </a>

  <!-- Sections -->
  <div class="mt-6 space-y-5">
    {navigationSections.map((section) => {
      const sectionHref = `/${section.key}`;
      const sectionActive = currentPath === sectionHref;

      return (
        <section>
          <!-- Section -->
          <a
            href={sectionHref}
            class:list={[
              "block border-l-2 px-3 py-1.5 text-[0.68rem] font-semibold uppercase tracking-[0.25em] transition",
              sectionActive
                ? "border-[var(--control-blue-bright)] text-white"
                : "border-transparent text-[var(--control-muted)] hover:border-[var(--control-blue)] hover:text-white",
            ]}
          >
            {section.title}
          </a>

          <!-- Pages -->
          {section.pages.length > 0 && (
            <ul class="mt-1">
              {section.pages.map((page) => {
                const active = currentPath === page.href;

                return (
                  <li>
                    <a
                      href={page.href}
                      class:list={[
                        "block border-l-2 px-3 py-1.5 pl-5 text-sm transition",
                        active
                          ? "border-[var(--control-blue-bright)] bg-[var(--control-panel)] font-medium text-white"
                          : "border-transparent text-slate-400 hover:border-[var(--control-blue)] hover:text-white",
                      ]}
                    >
                      {page.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      );
    })}
  </div>
</nav>