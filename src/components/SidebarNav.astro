---
import { navSections } from '../data/navigation';

interface Props {
	currentPath: string;
	mobile?: boolean;
}

const { currentPath, mobile = false } = Astro.props;

const isActive = (href: string) => currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
---

<nav aria-label="Primary navigation" class={mobile ? 'space-y-5' : 'space-y-5'}>
	{navSections.map((section) => (
		<section class="space-y-2">
			<p class="px-2 text-[0.65rem] uppercase tracking-[0.36em] text-slate-500">{section.label}</p>
			<div class="space-y-1">
				{section.items.map((item) => (
					<a
						href={item.href}
						class={`flex items-center justify-between rounded-lg border px-3 py-2 text-[0.9rem] transition ${isActive(item.href) ? 'border-sky-400/30 bg-sky-400/10 text-white' : 'border-transparent text-slate-300 hover:border-white/8 hover:bg-white/[0.04] hover:text-white'}`}
					>
						<span>{item.label}</span>
						{isActive(item.href) && <span aria-hidden="true" class="text-sky-300">•</span>}
					</a>
				))}
			</div>
		</section>
	))}
</nav>