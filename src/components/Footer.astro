---
import { site } from "../data/site";
---

<footer class="mt-10 border-t border-(--control-line) pt-5 text-xs text-(--control-muted)">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p>{site.footer.text} © {new Date().getFullYear()}</p>
      <p id="zulu-time" class="mt-1 font-mono text-[0.7rem] tracking-wide text-(--control-muted)">
        
      </p>
    </div>

    <p class="max-w-xl text-left sm:text-right">
      Unofficial VATSIM controller reference. Verify operational information against current official source material.
    </p>
  </div>
</footer>

<script>
  const zuluTime = document.getElementById("zulu-time");

  function updateZuluTime() {
    if (!zuluTime) return;

    const now = new Date();

    const date = now.toLocaleDateString("en-US", {
      weekday: "long",
      month: "long",
      day: "numeric",
      year: "numeric",
      timeZone: "UTC",
    });

    const time = now.toLocaleTimeString("en-US", {
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
      timeZone: "UTC",
    });

    zuluTime.textContent = `${date} at ${time}Z`;
  }

  updateZuluTime();
  setInterval(updateZuluTime, 1000);
</script>