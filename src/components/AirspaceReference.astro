---
import Badge from './Badge.astro';
import Card from './Card.astro';
import { airspaceItems } from '../data/control';
---

<Card>
	<div class="space-y-4">
		<div class="flex items-start justify-between gap-4">
			<div>
				<Badge tone="slate">Airspace</Badge>
				<h3 class="mt-3 font-display text-xl font-semibold text-white">Quick scan reference</h3>
			</div>
			<p class="text-right text-xs uppercase tracking-[0.3em] text-slate-500">Learn</p>
		</div>

		<div class="space-y-3">
			{airspaceItems.map((item) => (
				<div class="rounded-lg border border-white/8 bg-black/10 p-3">
					<p class="text-sm font-medium text-white">{item.label}</p>
					<p class="mt-1 text-sm leading-6 text-slate-300">{item.value}</p>
				</div>
			))}
		</div>
	</div>
</Card>